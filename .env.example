# Copy to .env (git-ignored) and fill in. Names only here, never real keys.
SVINKKI_DATA_DIR=dataset
SVINKKI_DB=data/svinkki.db
SVINKKI_STATE_DB=data/state.db
SVINKKI_TODAY=2026-09-26
SVINKKI_PORT=8000
# The AI model is Claude. Leave empty to use the built-in rules, or save the key in the app's
# Settings ("AI model (demo setup)"), which writes it to the git-ignored claude_api_key.txt.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5. A choice made in Settings wins.
CLAUDE_MODEL=
# Gemini is used only when there is no Claude key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
