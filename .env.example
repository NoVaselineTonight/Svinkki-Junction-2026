# Copy to .env (git-ignored) and fill in. Names only here, never real keys.
SVINKKI_DATA_DIR=C:/Users/onnik/Desktop/Junction-2026-S-pankki-filtered
SVINKKI_DB=data/svinkki.db
SVINKKI_STATE_DB=data/state.db
SVINKKI_TODAY=2026-09-26
SVINKKI_PORT=8000
# Leave empty to use the offline coach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Claude (Anthropic) is the preferred AI model. Leave ANTHROPIC_API_KEY unset to use claude_api_key.txt
# (git-ignored, one line). An explicitly empty value means "no Claude key".
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
SVINKKI_AI_KEY_FILE=claude_api_key.txt
